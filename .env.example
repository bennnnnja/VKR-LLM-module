# Ollama
OLLAMA_BASE_URL=http://ollama.example.dvfu.local:11434
LLM_TIMEOUT_SECONDS=120
SYNC_LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONCURRENT=2

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
API_KEY=replace-me-with-strong-random-string

# Job lifecycle
JOB_TTL_SECONDS=86400

# Models
MODEL_EVALUATE=qwen2.5:32b-instruct
MODEL_RECOMMENDATIONS=qwen2.5:32b-instruct
MODEL_TESTCASES=qwen3-coder-next
MODEL_DISCIPLINE=qwen3:8b
MODEL_EMBEDDING=qwen3-embedding:8b

# Доступные в текущем окружении модели (CSV)
AVAILABLE_MODELS=qwen2.5:32b-instruct

# Стратегия при недоступности целевой модели: stub | fallback | fail
FALLBACK_STRATEGY=stub
FALLBACK_MODEL=qwen2.5:32b-instruct

# Celery
CELERY_WORKER_CONCURRENCY=2
CELERY_PREFETCH_MULTIPLIER=1
